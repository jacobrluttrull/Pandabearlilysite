# Build context should carry source only — everything below is either rebuilt inside the
# image, machine-specific, or would bloat the upload.

.git
.gitignore
.mcp.json
.idea
.vscode
.claude
.agents

# Local runtime state. soundboard-api/data/ holds the SQLite file used for local
# development only; production reads and writes Turso over the network, so a database in
# the image would never be the real one — just stale play counts shipped to production.
soundboard-api/data/
soundboard-api/bin/
soundboard-api/go.work
soundboard-api/go.work.sum

# Credentials for the local machine — Turso and R2 keys. They reach the container from
# the environment, never from a file baked into a layer.
soundboard-api/.env
soundboard-api/.env.*

# Clip audio. Production serves it from R2, so shipping ~6.5 MB of MP3s in the image
# would only be a stale second copy of what the bucket already holds.
soundboard-api/clips/

# Working copies of the clips — staging, never the served collection.
Pandalily Soundbites/

# Rebuilt inside the image.
web/node_modules/
web/build/
web/.svelte-kit/
web/.env
web/.env.*

# Not part of the running service.
designs/
info/
README.md
CLAUDE.md
*.md
!soundboard-api/README.md
.playwright-mcp/
.review/
